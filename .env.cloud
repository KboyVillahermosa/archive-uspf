# Laravel Cloud Environment Variables
# Copy these settings to your Laravel Cloud environment variables

# Application
APP_NAME="Archive USPF"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-app-domain.com

# Database - Laravel Cloud will automatically set these when you create a database
# DB_CONNECTION=mysql
# DATABASE_URL will be set automatically by Laravel Cloud
# Or individual variables:
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Cache and Session
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Mail (configure based on your mail service)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Security
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error